<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox (direct distribution, not Mac App Store): the app must run
	     /usr/sbin/networksetup for the system-wide proxy mode, and dev builds load
	     the core from SINGLINK_LIB / ../singlink-protocol/build/libsinglink.dylib. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- libsinglink opens a local SOCKS5 listener and outbound tunnel connections. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
