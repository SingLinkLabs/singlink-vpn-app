// Application-level settings for the Runner target.

// The application's name (bundle file name SingLinkVPN.app and executable name).
// The user-visible name "SingLinkVPN" is CFBundleDisplayName in Info.plist.
PRODUCT_NAME = SingLinkVPN

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.singlinklabs.singlinkvpn

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 SingLinkLabs. All rights reserved.
